# 复制这个文件为 .env，填入你本机的真实值
# .env 已被 .gitignore 忽略，不会进仓库
#
# 用法（Git Bash）：
#   set -a; source .env; set +a
#
# 用法（IntelliJ）：Run Configuration → Environment variables 里加同名变量

# 二手车业务库口令（对应 MySQL 账号 usedcar_app）
USEDCAR_DB_PASSWORD=

# ---- AI 收车（硅基流动）----
# 在 https://cloud.siliconflow.cn 控制台创建 API Key，只填这里，不要发到聊天里、不要提交仓库
USEDCAR_AI_API_KEY=
# 模型 ID；模型广场里可查，2026-10-21 起该 ID 已由 1017 版本提供服务，无需改名
USEDCAR_AI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# 接口地址，一般不用改
USEDCAR_AI_BASE_URL=https://api.siliconflow.cn
# siliconflow=真实模型；mock=本地关键词解析（没 Key 时联调用，正式演示请改回 siliconflow）
USEDCAR_AI_PROVIDER=siliconflow
