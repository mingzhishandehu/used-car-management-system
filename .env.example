# 复制这个文件为 .env，填入你本机的真实值
# .env 已被 .gitignore 忽略，不会进仓库
#
# 用法（Git Bash）：
#   set -a; source .env; set +a
#
# 用法（IntelliJ）：Run Configuration → Environment variables 里加同名变量

# 二手车业务库口令（对应 MySQL 账号 usedcar_app）
USEDCAR_DB_PASSWORD=

# 以下为阶段四 AI 短视频才需要，暂时留空
# 火山引擎（Seedance 图生视频 / 聆眸数字人 / TTS）
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
# Spring AI 用的对话模型
DEEPSEEK_API_KEY=
